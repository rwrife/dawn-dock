{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dawn-dock.local/protocol/schemas/v1/alarm.schema.json",
  "title": "Dawn Dock v1 alarm",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "label",
    "enabled",
    "localTime",
    "days",
    "timezone",
    "snoozeMinutes",
    "volume",
    "sound",
    "source",
    "sourceEventId"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48
    },
    "enabled": {
      "type": "boolean"
    },
    "localTime": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 6
      }
    },
    "timezone": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "snoozeMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "volume": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "sound": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "ics"
      ]
    },
    "sourceEventId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    }
  }
}
